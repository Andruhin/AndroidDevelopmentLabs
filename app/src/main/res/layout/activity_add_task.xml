<?xml version="1.0" encoding="utf-8"?>
<!-- Кореневий контейнер екрана: вертикальний список елементів із відступом 16dp від країв -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".AddTaskActivity">

  <!-- Заголовок екрана -->
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="16dp"
      android:text="@string/add_task_title"
      android:textAppearance="?attr/textAppearanceHeadlineSmall" />

  <!-- Група «Назва»: обгортка Material з підказкою, у ній відображається помилка (setError) -->
  <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/til_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="16dp"
      android:hint="@string/task_name_hint">

    <!-- Поле введення назви задачі: один рядок, перша літера велика -->
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textCapSentences"
        android:maxLines="1" />
  </com.google.android.material.textfield.TextInputLayout>

  <!-- Група «Категорія»: підпис і випадаючий список в одному рядку (горизонтальний LinearLayout) -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="16dp">

    <!-- Підпис категорії -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/category_label"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <!-- Випадаючий список категорій; значення беруться зі string-array у strings.xml -->
    <Spinner
        android:id="@+id/spinner_category"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:entries="@array/categories" />
  </LinearLayout>

  <!-- Група «Пріоритет»: заголовок, колір якого змінюється залежно від вибору -->
  <TextView
      android:id="@+id/tv_priority_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:text="@string/priority_label"
      android:textAppearance="?attr/textAppearanceTitleMedium" />

  <!-- Перемикачі пріоритету в один рядок; за замовчуванням вибрано «Середній» -->
  <RadioGroup
      android:id="@+id/rg_priority"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="16dp"
      android:checkedButton="@+id/rb_medium"
      android:orientation="horizontal">

    <!-- Низький пріоритет (ширина 0dp + weight 1 — кнопки ділять рядок порівну) -->
    <RadioButton
        android:id="@+id/rb_low"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="@string/priority_low"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- Середній пріоритет -->
    <RadioButton
        android:id="@+id/rb_medium"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="@string/priority_medium"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- Високий пріоритет -->
    <RadioButton
        android:id="@+id/rb_high"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="@string/priority_high"
        android:textAppearance="?attr/textAppearanceBodyMedium" />
  </RadioGroup>

  <!-- Група «Геолокація»: прапорець прив'язки до геолокації -->
  <CheckBox
      android:id="@+id/cb_location"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/attach_location"
      android:textAppearance="?attr/textAppearanceBodyMedium" />

  <!-- Підказка під прапорцем; прихована (gone), показується з коду, коли прапорець відмічено -->
  <TextView
      android:id="@+id/tv_location_stub"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_marginTop="8dp"
      android:text="@string/location_stub"
      android:textAppearance="?attr/textAppearanceBodyMedium"
      android:visibility="gone" />

  <!-- Кнопка збереження задачі -->
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_save"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:text="@string/save_task" />
</LinearLayout>
